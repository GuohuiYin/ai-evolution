# 复制为 .env 并填入真实值（.env 已在 .gitignore 中，绝不提交）
# 模型 API Key（DeepSeek 聊天，OpenAI 兼容接口）
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
# Embedding API Key（SiliconFlow，bge-m3 向量化；DeepSeek 无 Embedding 能力）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# 本服务访问凭证（W30 #2 起）：主服务是 JWT 资源服务器，只认认证中心签发的 JWT——
# 不再需要本机共享 Key；如需覆盖 JWKS 地址再设 AUTH_CENTER_JWKS_URI（默认 http://localhost:19000/oauth2/jwks）
# AUTH_CENTER_JWKS_URI=http://localhost:19000/oauth2/jwks
# Tushare pro token（W17 真源；仅 ai.stock.data-source=tushare 时必填，tushare.pro 个人中心获取）
TUSHARE_TOKEN=
# === 以下为可选项（W12 MCP Client），均有默认值，按需覆盖 ===
# MCP Client 总开关（默认 true；测试与 CI 由测试属性关闭）
# AI_MCP_CLIENT_ENABLED=true
# uvx 命令名/路径（默认 uvx，按 PATH 解析；PATH 不含时填绝对路径）
# MCP_FETCH_COMMAND=uvx
# uv 包解析镜像（默认清华镜像；环境已配置时透传）
# UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# CORS 跨域白名单（W29 #3，逗号分隔；默认空 = 拒绝一切跨域，对话页同源访问无需配置）
# AI_SECURITY_CORS_ORIGINS=http://localhost:5173

TUSHARE_TOKEN=

# === W30 认证中心（auth-center/，独立工程，端口 19000） ===
# admin 种子口令的 argon2 哈希（由 PasswordHashTool 离线生成，含 {argon2} 前缀整串贴入）；
# 用户表无 admin 且此值为空时启动 fail-closed
AUTH_ADMIN_PASSWORD_HASH=
AUTH_ADMIN_USERNAME=admin
# MCP 机器客户端密钥（客户端凭证流；高熵随机串，生成如 openssl rand -hex 32）
AUTH_CLIENT_MCP_SECRET=
# 认证中心数据库（独立 auth schema，与主应用同 MySQL 实例、库级隔离；均有默认值，按需覆盖）
# AUTH_DB_URL=jdbc:mysql://localhost:3306/auth?createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=Asia/Shanghai
# AUTH_DB_USERNAME=root
# AUTH_DB_PASSWORD=
