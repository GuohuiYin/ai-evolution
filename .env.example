# 复制为 .env 并填入真实值（.env 已在 .gitignore 中，绝不提交）
# 模型 API Key（DeepSeek 聊天，OpenAI 兼容接口）
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
# Embedding API Key（SiliconFlow，bge-m3 向量化；DeepSeek 无 Embedding 能力）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# === 以下为可选项（W12 MCP Client），均有默认值，按需覆盖 ===
# MCP Client 总开关（默认 true；测试与 CI 由测试属性关闭）
# AI_MCP_CLIENT_ENABLED=true
# uvx 命令名/路径（默认 uvx，按 PATH 解析；PATH 不含时填绝对路径）
# MCP_FETCH_COMMAND=uvx
# uv 包解析镜像（默认清华镜像；环境已配置时透传）
# UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
